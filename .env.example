# wham — environment variables
#
# Copy to .env for local docker-compose runs. In Coolify, these are set as
# editable variables in the UI (see docker-compose.yaml) — never committed.
# Contract addresses are NOT here; they come from shared/deployments/<chainId>.json.

# ── Postgres (Coolify supplies SERVICE_USER_POSTGRES / SERVICE_PASSWORD_POSTGRES
#    automatically; set these two only for local docker-compose) ───────────────
SERVICE_USER_POSTGRES=wham
SERVICE_PASSWORD_POSTGRES=changeme

# ── Chain ──────────────────────────────────────────────────────────────────
WHAM_CHAIN_ID=421614
WHAM_RPC_URL=                          # paid RPC primary (Alchemy/Infura)
WHAM_RPC_URL_FALLBACK=https://sepolia-rollup.arbitrum.io/rpc

# ── Public domain / auth (api + frontend) ───────────────────────────────────
WHAM_PUBLIC_DOMAIN=                    # e.g. wham.example.com
WHAM_JWT_SIGNING_KEY=                  # 32+ bytes, random

# ── Frontend ────────────────────────────────────────────────────────────────
# For `pnpm dev`, copy these lines into frontend/.env.local (Next reads it from
# there). NEXT_PUBLIC_* are BUILD args: inlined into the client bundle, so
# changing them means rebuilding, not restarting.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=  # required; free at https://cloud.reown.com
NEXT_PUBLIC_CHAIN_ID=421614            # 421614 Arbitrum Sepolia | 42161 Arbitrum One
NEXT_PUBLIC_USE_MOCKS=true             # local dev without the .NET backend
WHAM_API_URL=                          # e.g. http://localhost:8080; needed at BUILD and runtime unless mocks are on

# ── Workers only: signing keys ──────────────────────────────────────────────
WHAM_AGENT_PRIVATE_KEY=                # signs EIP-712 quotes + attestations
WHAM_KEEPER_PRIVATE_KEY=               # sends settleRound / start / cancel

# ── Workers: notifications (optional) ───────────────────────────────────────
WHAM_EMAIL_API_KEY=
WHAM_TELEGRAM_BOT_TOKEN=

# ── Contracts (local-only, never in compose) ────────────────────────────────
DEPLOYER_PK=
AGENT_ADDRESS=
ARB_SEPOLIA_RPC=
ARBISCAN_API_KEY=
